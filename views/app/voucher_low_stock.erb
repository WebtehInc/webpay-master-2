<html>
  <head>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/semantic-ui/1.11.8/semantic.min.css"/>
  </head>

  <body>
    <div class="ui container" style="margin: 1em;">

      <h2 class="ui header">
        <div class="content">
          Voucher low stock notification
          <div class="sub header">
            <%= WebPay.opts[:bank_name] %> <%= WebPay.opts[:app_name] %>
          </div>
        </div>
      </h2>

      <ul>
        <li>Product: <strong><%= product[:name] %></strong></li>
        <li>Quantity: <strong><%= product[:notify_quantity] %></strong></li>
        <li>Last replenish: <strong><%= product[:last_replenish] %></strong></li>
      </ul>

    </div>
  </body>

</html>


