<html>
  <head>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/semantic-ui/1.11.8/semantic.min.css"/>
  </head>

  <body>
    <div class="ui container" style="margin: 1em;">

      <h2 class="ui header">
        <div class="content">
          Password reset
          <div class="sub header">
            <%= WebPay.opts[:bank_name] %> <%= WebPay.opts[:app_name] %>
          </div>
        </div>
      </h2>

      <p>
        Dear <%= "#{user[:first_name]} #{user[:last_name]}" %>,
      </p>

      <p>
        To change your password follow this link:<br>
        <a href="<%= "#{Mailer.opts[:spa_constants][:reset_password_path]}/#{user[:token]}" %>">
          <%= "#{Mailer.opts[:spa_constants][:reset_password_path]}/#{user[:token]}" %>
        </a>
      </p>

      <p>Have a nice day!</p>

    </div>
  </body>

</html>



