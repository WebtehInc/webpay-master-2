# WebPay Master Environment Configuration
# Copy this file to .env and configure for your environment

# ======================================
# ENVIRONMENT
# ======================================
# Options: development, uat, production
WP_ENV=development
RACK_ENV=development

# ======================================
# DATABASE
# ======================================
# PostgreSQL connection string format: postgres://user:password@host:port/database
# IMPORTANT: Use WP_DEV_DATABASE_URL for development, WP_PROD_DATABASE_URL for production
# UAT uses Aurora PostgreSQL 16.9
WP_DEV_DATABASE_URL=postgres://postgres:YOUR_DB_PASSWORD@uat-aurora-pg16.cluster-ck3ueww0umem.us-east-1.rds.amazonaws.com:5432/webpay_development
WP_PROD_DATABASE_URL=postgres://postgres:YOUR_DB_PASSWORD@uat-aurora-pg16.cluster-ck3ueww0umem.us-east-1.rds.amazonaws.com:5432/webpay_production
WP_TEST_DATABASE_URL=postgres://postgres@localhost:5435/webpay_test

# ======================================
# SMTP (Email Configuration)
# ======================================
# Gmail Configuration (Recommended for Development):
# 1. Enable 2-Step Verification on your Gmail account
# 2. Create App Password: https://myaccount.google.com/apppasswords
# 3. Use App Password (not your regular Gmail password)
#
# Current Setup: sanchopansayelburro@gmail.com
# App Password: owcs ydni jpsb dcxs (use quotes if password has spaces!)
#
# Alternative: Use MailHog for local testing
# MailHog: WP_SMTP_HOST=localhost, WP_SMTP_PORT=1025
WP_SMTP_HOST=smtp.gmail.com
WP_SMTP_PORT=587
WP_SMTP_USERNAME=sanchopansayelburro@gmail.com
WP_SMTP_PASSWORD="owcs ydni jpsb dcxs"

# ======================================
# SPA (Single Page Application)
# ======================================
# URL to webpay-spa frontend (Vue.js 2.7 hash mode routing)
# UAT: https://webpay-spa.uat.vidanovabank.services
# Local dev: http://localhost:2222
WP_SPA_HOST_URL=https://webpay-spa.uat.vidanovabank.services

# ======================================
# SECURITY
# ======================================
# OTP (One-Time Password) Time-To-Live in seconds
OTP_TTL=300

# JWT (JSON Web Token) settings
# Generate with: openssl rand -base64 32
JWT_KEY=YOUR_JWT_KEY_HERE
JWT_TTL=1800

# Mobile app authentication key
# Generate with: openssl rand -base64 32
MOBILE_KEY=YOUR_MOBILE_KEY_HERE

# ======================================
# APPLICATION SETTINGS
# ======================================
APP_NAME=WebPay UAT
BANK_NAME=Vidanova Bank
DEFAULT_CURENCY=XCG
DEFAULT_COUNTRY=CW

# ======================================
# ERROR NOTIFICATIONS
# ======================================
# Comma-separated list of emails to receive exception notifications
ERROR_EMAIL=tech@vidanovabank.services

# ======================================
# PUMA SERVER
# ======================================
# Server port (default: 4444 for master)
PORT=4444

# Worker configuration
# PUMA_MAX_PROCESSES: Number of Puma worker processes (0 for single mode)
# PUMA_MAX_THREADS: Maximum number of threads per worker
PUMA_MAX_PROCESSES=2
PUMA_MAX_THREADS=5

# Worker killer (set to true to enable memory-based worker restarts)
PUMA_WORKER_KILLER=false

# ======================================
# EXTERNAL SERVICES
# ======================================

# Core bank service (options: fiserv, pagatinu)
CORE_BANK_SERVICE=fiserv

# Switch URLs (UAT Gateway)
ISO_SWITCH_URL=http://switch-uat-1a.vidanovabank.link:5005
INFOSWITCH_URL=http://switch-uat-1a.vidanovabank.link:5002

# Pagatinu service (options: mock, live)
PAGATINU_CLIENT=mock
PAGATINU_URL=http://localhost:12345/GatewayServiceASP.asmx

# Fiserv service (options: mock, live)
FISERV_CLIENT=mock
FISERV_URL=http://localhost:12345/TEST/CRG.aspx
FISERV_WALLET_ACCOUNT_ID=270900000006
FISERV_WALLET_ACCOUNT_TYPE=GL

# ======================================
# MEMCACHED (AWS ElastiCache)
# ======================================
MEMCACHED_URL=uat-webpay-memcached.ray4je.0001.use1.cache.amazonaws.com:11211
MEMCACHED_PORT=11211

# ======================================
# INFOSWITCH GATEWAY (Switch Integration)
# ======================================
# Merchant credentials for HMAC-SHA512 authentication
# Get these from Switch Admin or documentation
# Both tokens are 128-character hex strings
INFOSWITCH_AUTHENTICITY_TOKEN=YOUR_128_CHAR_AUTHENTICITY_TOKEN_HERE
INFOSWITCH_SECRET=YOUR_128_CHAR_SECRET_HERE
INFOSWITCH_MODULE=girasol
